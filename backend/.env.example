# Groq Cloud API Key (Get free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# SQLite or PostgreSQL database URL
DATABASE_URL=sqlite:///./mediscan.db

# JWT Secret Key for Authentication
SECRET_KEY=your_secret_key_here_generate_random

# Optional custom path for Tesseract OCR binary (Linux/Mac automatically detects 'tesseract')
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
